SOLARI_API_KEY=slr_live_...

# GitHub Issue monitor and PR target.
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=owner/name
ISSUEPATCH_MODE=fixture
ISSUEPATCH_POLL_INTERVAL_MS=60000
ISSUEPATCH_MENTION=@IssuePatch
ISSUEPATCH_STATE_PATH=.issuepatch/state.json
ISSUEPATCH_INCLUDE_EXISTING=false

# Anthropic Messages-compatible endpoint (DeepSeek V4 Flash by default).
LLM_API_KEY=...
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
